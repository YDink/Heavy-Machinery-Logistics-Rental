# Committed Shared Local Development Configuration (No Production Secrets)
# System & Multi-Country Context
ENVIRONMENT=development
SYSTEM_TIMEZONE=Africa/Addis_Ababa
DEFAULT_COUNTRY_CODE=ET
DEFAULT_CURRENCY=ETB

# Backend Core (Go 1.27.3)
PORT=8080
API_BASE_URL=http://localhost:8080/api/v1
SWAGGER_ENABLED=true
LOG_LEVEL=debug
LOG_FORMAT=json

# Primary Persistence (PostgreSQL 18.6 + PostGIS 3.6.4)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dink_machinery_dev?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15m

# Cache, Rate Limiting & Transient State (Valkey 9.1.3)
VALKEY_URL=redis://localhost:6379/0

# Object Storage (SeaweedFS / Local MinIO)
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=dink-media-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# Antivirus & File Security (ClamAV Daemon)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Security, Sessions & JWT (Development Placeholders)
JWT_SECRET_KEY=dev_jwt_secret_signing_key_32_bytes_long_min!!
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30
AES_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Observability (OpenTelemetry, VictoriaMetrics, Tempo, Loki)
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=dink-backend-dev
METRICS_PORT=9090

# Next.js Admin Panel (Next.js 16.x - Latest CVE Security Patch)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
ADMIN_PORT=3000

# Mobile Application (Flutter 3.44)
FLUTTER_API_BASE_URL=http://10.0.2.2:8080/api/v1