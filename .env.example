# Environment Variable Template for Dink Machinery
# System & Multi-Country Context
ENVIRONMENT=                    # string: development|staging|production
SYSTEM_TIMEZONE=                # string: IANA timezone (e.g. Africa/Addis_Ababa)
DEFAULT_COUNTRY_CODE=           # string: ISO 3166-1 alpha-2 (e.g. ET, KE)
DEFAULT_CURRENCY=               # string: ISO 4217 (e.g. ETB, USD)

# Backend Core
PORT=                           # integer: API server port (e.g. 8080)
API_BASE_URL=                   # string: Base API route (e.g. https://api.dinkmachinery.com/api/v1)
SWAGGER_ENABLED=                # boolean: true|false
LOG_LEVEL=                      # string: debug|info|warn|error
LOG_FORMAT=                     # string: json|text

# Primary Persistence (PostgreSQL 18.4 + PostGIS)
DATABASE_URL=                   # string: PostgreSQL connection string
DB_MAX_OPEN_CONNS=              # integer: Pool max open connections
DB_MAX_IDLE_CONNS=              # integer: Pool idle limit
DB_CONN_MAX_LIFETIME=           # duration: Pool connection max lifetime (e.g. 15m)

# Cache & Rate Limiting (Valkey 8.0)
VALKEY_URL=                     # string: Valkey connection string

# Object Storage (SeaweedFS / S3)
S3_ENDPOINT=                    # string: S3 host endpoint
S3_REGION=                      # string: S3 region
S3_BUCKET_NAME=                 # string: Target bucket
S3_ACCESS_KEY=                  # string: S3 access key
S3_SECRET_KEY=                  # string: S3 secret key
S3_USE_SSL=                     # boolean: true|false

# Antivirus & File Security
CLAMAV_HOST=                    # string: ClamAV daemon host
CLAMAV_PORT=                    # integer: ClamAV port (e.g. 3310)

# Cryptographic Keys
JWT_SECRET_KEY=                 # string: HMAC-SHA256 signing secret
JWT_ACCESS_EXPIRY_MINUTES=      # integer: Access token lifespan in minutes
JWT_REFRESH_EXPIRY_DAYS=        # integer: Refresh token lifespan in days
AES_MASTER_ENCRYPTION_KEY=      # hex: 64 hex characters (32 bytes) for AES-256-GCM

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=    # string: OTLP gRPC endpoint (e.g. localhost:4317)
OTEL_EXPORTER_OTLP_INSECURE=    # boolean: true|false
OTEL_SERVICE_NAME=              # string: Service identifier
METRICS_PORT=                   # integer: Prometheus metrics port (e.g. 9090)

# Frontends
NEXT_PUBLIC_API_URL=            # string: Next.js API client URL
ADMIN_PORT=                     # integer: Next.js server port
FLUTTER_API_BASE_URL=           # string: Mobile app backend URL